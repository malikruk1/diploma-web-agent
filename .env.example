# ===== Яку модель використовувати (розкоментуй ОДИН рядок MODEL) =====

# 1) OpenAI — дуже дешево ($0.10 / 1M вхідних токенів). Ключ: https://platform.openai.com/api-keys
MODEL=openai:gpt-6-luna
OPENAI_API_KEY=sk-proj-...

# 2) Groq — безкоштовно, без картки. Ключ: https://console.groq.com/keys
# MODEL=groq:meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_API_KEY=gsk_...

# 3) Ollama — безкоштовно, локально на твоєму ПК (спершу: ollama pull qwen3.5:9b)
# MODEL=ollama:qwen3.5:9b

# 4) Claude — платно. Ключ: https://console.anthropic.com
# MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# ===== Трасування в LangSmith (безкоштовно): https://smith.langchain.com -> Settings -> API Keys =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=diploma-web-agent
